@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontSize 22
skinparam SequenceMessageFontSize 20
skinparam SequenceBoxFontSize 21
skinparam ParticipantPadding 2
skinparam Padding 0
skinparam Participant {
    Padding 8
}

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":AddCommandParser" as AddCommandParser LOGIC_COLOR
participant "a:AddCommand" as AddCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
participant ":Messages" as Messages LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("add ...")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("add ...")
activate AddressBookParser

create AddCommandParser
AddressBookParser -> AddCommandParser
activate AddCommandParser

AddCommandParser -> AddCommandParser : validate input and parse fields

alt invalid command format or field value
    AddCommandParser --> AddressBookParser : throws ParseException
    deactivate AddCommandParser
    AddressBookParser --> LogicManager : throws ParseException
    deactivate AddressBookParser
    [<--LogicManager
    deactivate LogicManager
else valid input
    AddCommandParser -> AddCommand : create Person and AddCommand
    AddCommand --> AddCommandParser
    AddCommandParser --> AddressBookParser : a
    deactivate AddCommandParser

    AddressBookParser --> LogicManager : a
    deactivate AddressBookParser

    LogicManager -> AddCommand : execute(m)
    activate AddCommand
    AddCommand -> Model : hasPerson(toAdd)
    activate Model
    Model --> AddCommand : duplicate status
    deactivate Model

    alt duplicate person
        AddCommand --> LogicManager : throws CommandException
        deactivate AddCommand
    else new person
        AddCommand -> Model : getAddressBook().getPersonList()
        activate Model
        Model --> AddCommand : existing persons
        deactivate Model
        AddCommand -> Messages : getSimilarNameWarning(...)
        activate Messages
        Messages --> AddCommand : warning or empty string
        deactivate Messages

        AddCommand -> Model : addPerson(toAdd)
        activate Model
        Model --> AddCommand
        deactivate Model
        AddCommand -> Messages : format(toAdd)
        activate Messages
        Messages --> AddCommand : formatted person
        deactivate Messages
        create CommandResult
        AddCommand -> CommandResult : create success result
        CommandResult --> AddCommand
        deactivate CommandResult
        AddCommand --> LogicManager : r
        deactivate AddCommand
    end
    [<--LogicManager
    deactivate LogicManager
end
@enduml
