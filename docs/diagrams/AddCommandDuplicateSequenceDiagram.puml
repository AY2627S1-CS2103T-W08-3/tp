@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontSize 22
skinparam SequenceMessageFontSize 20
skinparam SequenceBoxFontSize 21
skinparam ParticipantPadding 2
skinparam Padding 0
skinparam Participant {
    Padding 8
}

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "a:AddCommand" as AddCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

activate LogicManager
alt duplicate name other than "UNKNOWN"
    LogicManager -> AddCommand : execute(m)
    activate AddCommand
    AddCommand -> Model : hasPerson(toAdd)
    activate Model
    Model --> AddCommand : true
    deactivate Model
    AddCommand --> LogicManager : throws CommandException
    deactivate AddCommand
else new name or name is "UNKNOWN"
    LogicManager -> AddCommand : execute(m)
    activate AddCommand
    AddCommand -> Model : hasPerson(toAdd)
    activate Model
    Model --> AddCommand : hasDuplicate
    deactivate Model
    ref over AddCommand, Model
        Successful person addition
    end ref
    AddCommand --> LogicManager : r
    deactivate AddCommand
end
@enduml
