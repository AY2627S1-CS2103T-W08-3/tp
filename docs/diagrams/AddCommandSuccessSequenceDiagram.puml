@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontSize 22
skinparam SequenceMessageFontSize 20
skinparam SequenceBoxFontSize 21
skinparam ParticipantPadding 2
skinparam Padding 0
skinparam Participant {
    Padding 8
}

title Successful person addition

box Logic LOGIC_COLOR_T1
participant "a:AddCommand" as AddCommand LOGIC_COLOR
participant "Messages" as Messages <<class>> LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant ":ReadOnlyAddressBook" as AddressBook MODEL_COLOR
end box

note over AddCommand
    Continuation of execute(m) after
    the duplicate-name check passes.
end note

AddCommand -> Model : getAddressBook()
activate Model
Model --> AddCommand : addressBook
deactivate Model
AddCommand -> AddressBook : getPersonList()
activate AddressBook
AddressBook --> AddCommand : existingPersons
deactivate AddressBook
AddCommand -> Messages : getSimilarNameWarning(toAdd, existingPersons, null)
activate Messages
Messages --> AddCommand : warning
deactivate Messages
AddCommand -> Model : addPerson(toAdd)
activate Model
Model --> AddCommand
deactivate Model
AddCommand -> Messages : format(toAdd)
activate Messages
Messages --> AddCommand : formattedPerson
deactivate Messages
create CommandResult
AddCommand -> CommandResult : CommandResult(successMessage + warning)
note over AddCommand, CommandResult
    r is returned by execute(m) in
    the execution and duplicate-detection diagram.
    Logging and string formatting details omitted.
end note
@enduml
