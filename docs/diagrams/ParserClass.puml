@startuml
!include style.puml

skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

Class "<<interface>>\nParser" as Parser {
  +parse(userInput: String): T
}
Class RemarkCommandParser {
  +parse(args: String): RemarkCommand
}
Class RemarkCommand
Class ParseException
Class ArgumentTokenizer
Class ArgumentMultimap
Class ParserUtil

RemarkCommandParser .up.|> Parser
RemarkCommandParser ..> RemarkCommand : <<create>>
RemarkCommandParser ..> ParseException : throws >
RemarkCommandParser ..> ArgumentTokenizer : <<use>>
RemarkCommandParser ..> ArgumentMultimap : <<use>>
RemarkCommandParser ..> ParserUtil : <<use>>
ArgumentTokenizer ..> ArgumentMultimap : <<create>>
@enduml
