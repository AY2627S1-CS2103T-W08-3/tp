@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam DefaultFontSize 18
skinparam Sequence {
    ArrowFontSize 18
    ParticipantFontSize 18
    BoxFontSize 18
}
skinparam NoteFontSize 18
skinparam ParticipantPadding 0

title Find clients by name or tag (successful search)

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":FindCommandParser" as FindCommandParser LOGIC_COLOR
participant "f:FindCommand" as FindCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as Model MODEL_COLOR
end box

[-> LogicManager : execute(\n"find Alice t/friends")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand(\n"find Alice t/friends")
activate AddressBookParser

create FindCommandParser
AddressBookParser -> FindCommandParser : new\nFindCommandParser()
AddressBookParser -> FindCommandParser : parse(\n" Alice t/friends")
activate FindCommandParser

note right of FindCommandParser
Tokenize and validate arguments.
Create predicate p for
name "Alice" OR tag "friends".
end note

create FindCommand
FindCommandParser -> FindCommand : new FindCommand(p)
activate FindCommand
FindCommand --> FindCommandParser : f
deactivate FindCommand

FindCommandParser --> AddressBookParser : f
deactivate FindCommandParser

AddressBookParser --> LogicManager : f
deactivate AddressBookParser

LogicManager -> FindCommand : execute(m)
activate FindCommand

FindCommand -> Model : updateFilteredPersonList(p)
activate Model
note left of Model
Apply p to the full client list.
The UI observes the results.
end note
Model --> FindCommand
deactivate Model

FindCommand -> Model : getFilteredPersonList()
activate Model
Model --> FindCommand : filtered and\nsorted clients
deactivate Model

note over FindCommand
N = returnedList.size()
end note

create CommandResult
FindCommand -> CommandResult : new CommandResult(\n"N person(s) listed!")
activate CommandResult
CommandResult --> FindCommand : r
deactivate CommandResult

FindCommand --> LogicManager : r
deactivate FindCommand

[<-- LogicManager : r
deactivate LogicManager
@enduml
