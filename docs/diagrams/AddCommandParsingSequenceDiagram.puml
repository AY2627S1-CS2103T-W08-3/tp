@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontSize 22
skinparam SequenceMessageFontSize 20
skinparam SequenceBoxFontSize 21
skinparam ParticipantPadding 2
skinparam Padding 0
skinparam Participant {
    Padding 8
}

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":AddCommandParser" as AddCommandParser LOGIC_COLOR
participant "a:AddCommand" as AddCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "p:Person" as Person MODEL_COLOR
end box

LogicManager -> AddressBookParser : parseCommand("add ...")
create AddCommandParser
AddressBookParser -> AddCommandParser : AddCommandParser()
AddressBookParser -> AddCommandParser : parse(arguments)

note over AddCommandParser
    Tokenize and validate fields.
    Field-value construction details omitted.
end note

alt invalid command format or field value
    AddCommandParser --> AddressBookParser : throws ParseException
    AddressBookParser --> LogicManager : throws ParseException
else valid input
    create Person
    AddCommandParser -> Person : Person(name, phone, email, address, remark, tags)
    create AddCommand
    AddCommandParser -> AddCommand : AddCommand(p)
    AddCommandParser --> AddressBookParser : a
    AddressBookParser --> LogicManager : a
end
@enduml
