@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":UndeleteCommandParser" as UndeleteCommandParser LOGIC_COLOR
participant "u:UndeleteCommand" as UndeleteCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as ModelManager MODEL_COLOR
participant "deletedPersons:Deque" as Deque MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
end box

[-> LogicManager : execute("undelete")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("undelete")
activate AddressBookParser

create UndeleteCommandParser
AddressBookParser -> UndeleteCommandParser : UndeleteCommandParser()
activate UndeleteCommandParser

UndeleteCommandParser --> AddressBookParser
deactivate UndeleteCommandParser

AddressBookParser -> UndeleteCommandParser : parse("")
activate UndeleteCommandParser

create UndeleteCommand
UndeleteCommandParser -> UndeleteCommand : UndeleteCommand()
activate UndeleteCommand

UndeleteCommand --> UndeleteCommandParser
deactivate UndeleteCommand

UndeleteCommandParser --> AddressBookParser : u
deactivate UndeleteCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
UndeleteCommandParser -[hidden]-> AddressBookParser
destroy UndeleteCommandParser

AddressBookParser --> LogicManager : u
deactivate AddressBookParser

LogicManager -> UndeleteCommand : execute(m)
activate UndeleteCommand

UndeleteCommand -> ModelManager : hasDeletedPersons()
activate ModelManager

ModelManager --> UndeleteCommand : true
deactivate ModelManager

UndeleteCommand -> ModelManager : getLastDeletedPerson()
activate ModelManager

ModelManager -> Deque : element()
activate Deque

Deque --> ModelManager : last
deactivate Deque

ModelManager --> UndeleteCommand : p
deactivate ModelManager

UndeleteCommand -> ModelManager : hasPerson(p)
activate ModelManager

ModelManager --> UndeleteCommand : false
deactivate ModelManager

UndeleteCommand -> ModelManager : restoreLastDeletedPerson()
activate ModelManager

ModelManager -> Deque : element()
activate Deque

Deque --> ModelManager : last
deactivate Deque

ModelManager -> AddressBook : addPerson(index, p)
activate AddressBook

AddressBook --> ModelManager
deactivate AddressBook

ModelManager -> Deque : pop()
activate Deque

Deque --> ModelManager
deactivate Deque

ModelManager -> ModelManager : updateFilteredPersonList(\nPREDICATE_SHOW_ALL_PERSONS)
activate ModelManager

ModelManager --> ModelManager
deactivate ModelManager

ModelManager --> UndeleteCommand
deactivate ModelManager

create CommandResult
UndeleteCommand -> CommandResult : CommandResult(message)
activate CommandResult

CommandResult --> UndeleteCommand
deactivate CommandResult

UndeleteCommand --> LogicManager : r
deactivate UndeleteCommand
UndeleteCommand -[hidden]-> LogicManager
destroy UndeleteCommand

[<--LogicManager : r
deactivate LogicManager
@enduml
